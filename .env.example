# DriftGuard Backend Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# SQLite Persistence Path (defaults to data/driftguard.db)
DATABASE_PATH=data/driftguard.db

# Cryptographic Session & Cookie Secret (Change in production!)
COOKIE_SECRET=driftguard-cryptographic-cookie-secret-min-32-chars-long

# Session Lifetime (in hours, default 7 days)
SESSION_TTL_HOURS=168

# Frontend Target Backend URL
VITE_API_URL=http://localhost:3001
